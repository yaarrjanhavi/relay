# =====================================================================
# Relay: Self-Learning LLM Router Environment Configuration
# =====================================================================

# LLM Provider Configuration
# Optional: If unset, Relay automatically runs offline with the deterministic MockProvider
GEMINI_API_KEY=

# Verified Current Gemini Models (verified against official ai.google.dev docs)
# Small Tier (Flash-Lite class): $0.10 / 1M in, $0.40 / 1M out
GEMINI_MODEL_SMALL=gemini-2.5-flash-lite

# Medium Tier (Flash class): $0.30 / 1M in, $2.50 / 1M out
GEMINI_MODEL_MEDIUM=gemini-2.5-flash

# Large Tier (Pro class): $1.25 / 1M in, $10.00 / 1M out
GEMINI_MODEL_LARGE=gemini-2.5-pro

# Text Embeddings Model
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# Infrastructure
REDIS_URL=redis://localhost:6379/0
ROUTER_DB=relay.db

# Bayesian Bandit Parameters
# LAMBDA: Cost-penalty coefficient in score = theta - LAMBDA * (tier_cost / max_tier_cost)
LAMBDA=0.25

# Daily retention rate for time-decay toward prior Beta(1,1)
RETENTION_PER_DAY=0.98

# LLM-as-Judge Auto-Feedback Sample Rate (0.0 = disabled, 0.1 = 10% sampled)
JUDGE_SAMPLE_RATE=0.0

# Optional Tier Price Overrides (USD per 1,000,000 tokens)
# Note: Defaults in app/config.py should be re-verified against https://ai.google.dev/pricing
# PRICE_SMALL_INPUT=0.10
# PRICE_SMALL_OUTPUT=0.40
# PRICE_MEDIUM_INPUT=0.30
# PRICE_MEDIUM_OUTPUT=2.50
# PRICE_LARGE_INPUT=1.25
# PRICE_LARGE_OUTPUT=10.00
